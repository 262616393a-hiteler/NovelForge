<resources>

    <style name="Theme.NovelCraft" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary_color</item>
        <item name="android:colorPrimaryDark">@color/primary_deep</item>
        <item name="android:colorAccent">@color/accent_color</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:textColorPrimary">@color/primary_text</item>
        <item name="android:textColorSecondary">@color/secondary_text</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@color/primary_deep</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorButtonNormal">@color/primary_color</item>
    </style>

    <style name="Widget.NovelCraft.SectionTitle" parent="">
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <style name="BottomNav.Tab" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:backgroundTint">@color/surface</item>
        <item name="android:textColor">@color/secondary_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>

</resources>
